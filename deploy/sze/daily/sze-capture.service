[Unit]
Description=Shenzhen fixed market-data capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zane/run_main
ExecStartPre=/home/zane/run_main/sze_daily_preflight.sh capture
ExecStart=/home/zane/run_main/run_sze_capture_daily.sh
KillSignal=SIGINT
TimeoutStopSec=120
Restart=no

[Install]
WantedBy=multi-user.target
