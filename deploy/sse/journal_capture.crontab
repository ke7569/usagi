SHELL=/bin/bash
# SSE raw capture runs independently of daily config, prediction and trading.
# Rotate to today's journal before the opening auction; stop after close.
55 8 * * 1-5 /usr/bin/systemctl restart sse-journal-capture.service
56 8 * * 1-5 /usr/bin/python2 /home/zane/usagi-sse-dev/deploy/sse/check_journal_capture.py preopen --root /home/zane/usagi-runtime >> /home/zane/usagi-runtime/ops.log 2>&1
# Prediction/strategy/TD starts independently and reads today's daily directly.
57 8 * * 1-5 /usr/bin/systemctl restart sse-journal-trading.service
16 9 * * 1-5 /usr/bin/python2 /home/zane/usagi-sse-dev/deploy/sse/check_journal_capture.py intraday --root /home/zane/usagi-runtime >> /home/zane/usagi-runtime/ops.log 2>&1
1 13 * * 1-5 /usr/bin/python2 /home/zane/usagi-sse-dev/deploy/sse/check_journal_capture.py intraday --root /home/zane/usagi-runtime >> /home/zane/usagi-runtime/ops.log 2>&1
9 15 * * 1-5 /usr/bin/systemctl stop sse-journal-trading.service
10 15 * * 1-5 /usr/bin/systemctl stop sse-journal-capture.service
11 15 * * 1-5 /usr/bin/python2 /home/zane/usagi-sse-dev/deploy/sse/check_journal_capture.py closed --root /home/zane/usagi-runtime >> /home/zane/usagi-runtime/ops.log 2>&1
20 15 * * 1-5 /usr/bin/python2 /home/zane/usagi-sse-dev/tools/sse/prune_capture_days.py --root /home/zane/usagi-runtime --keep-days 5 --apply >> /home/zane/usagi-runtime/ops.log 2>&1

# The old integrated launcher is intentionally disabled: it owns a different
# capture format and would compete for the same multicast feed. Prediction can
# be replayed from this journal after capture is complete.
# 55 8 * * 1-5 /home/zane/sse/scripts/sse_daily.sh start
# 10 15 * * 1-5 /home/zane/sse/scripts/sse_daily.sh stop
# 41 9 * * 1-5 /home/zane/sse/scripts/sse_daily.sh stop-snapshot
# 42 9 * * 1-5 /home/zane/sse/scripts/sse_daily.sh verify posttick
# 20 15 * * 1-5 /home/zane/sse/scripts/sse_daily.sh retention

# Retired legacy trading restart; new trading is owned by the usagi runtime.
# 35 11 * * 1-5 /home/zane/sse/scripts/restart_sse_trade_1135.sh
